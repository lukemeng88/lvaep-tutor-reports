# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key. Never expose to the browser. Only used by scripts (seed helpers), never by app code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used by the Playwright smoke test (optional, defaults to http://localhost:3000)
PLAYWRIGHT_BASE_URL=http://localhost:3000
